{
  "name": "npm-trend-clone",
  "version": "0.1.0",
  "description": "A modern clone of npmtrends.com built with Next.js 16, featuring npm package download statistics comparison and visualization",
  "author": "Ryota Murakami <ryota.murakami@laststance.io> (https://github.com/ryota-murakami)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laststance/npm-trend-clone.git"
  },
  "homepage": "https://github.com/laststance/npm-trend-clone#readme",
  "bugs": {
    "url": "https://github.com/laststance/npm-trend-clone/issues"
  },
  "keywords": [
    "npm",
    "trends",
    "statistics",
    "nextjs",
    "typescript",
    "react"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3041",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "build:e2e": "prisma generate && DATABASE_URL=postgresql://postgres:postgres@localhost:54321/npm_trend_clone prisma db push --accept-data-loss && NEXT_PUBLIC_ENABLE_MSW_MOCK=true APP_ENV=test next build",
    "start": "next start -p 3041",
    "start:e2e": "NEXT_PUBLIC_ENABLE_MSW_MOCK=true APP_ENV=test next start -p 3041",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6010",
    "build-storybook": "storybook build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.17.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.108.4",
    "@upstash/ratelimit": "^2.2.2",
    "@upstash/redis": "^1.41.1",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "modern-screenshot": "^4.7.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.35",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.1",
    "resend": "^6.39.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@chromatic-com/storybook": "^5.6.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/nextjs": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-storybook": "^10.6.8",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.65.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
